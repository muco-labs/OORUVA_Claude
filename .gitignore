*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/

# Local test database (throwaway PostgreSQL cluster)
/pgtest/

# Firebase config. SETUP.md told people this was already ignored; it was not.
# Not a private key, but it identifies the project and does not belong in a
# public repository.
app/google-services.json

# Signing material. A committed keystore cannot be un-committed in any way
# that matters -- it has to be rotated and every published build re-signed.
*.jks
*.keystore
keystore.properties

# Edge function secrets, pushed with `supabase secrets set --env-file`.
# Same reasoning as local.properties: the JWT secret is as powerful as the
# service role key, and a shell that mangles a pasted value is a worse way to
# set it than a file.
supabase/functions/.env
supabase/.env
