<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OORUVA" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/espresso_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.OORUVA.Main</item>
    </style>

    <style name="Theme.OORUVA.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ivory</item>
    </style>
</resources>
